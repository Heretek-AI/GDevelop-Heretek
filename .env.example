# Firebase Web API key for the gdevelop-services project.
# Owned by the upstream 4ian/GDevelop project.
GD_FIREBASE_API_KEY=

# Firebase Web API key for the gdtest-e11a5 *test* project, used by the
# Firebase extension end-to-end test in Extensions/Firebase/tests/.
GD_TEST_FIREBASE_API_KEY=
