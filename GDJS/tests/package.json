{
  "name": "GDJS-tests",
  "version": "0.0.0",
  "description": "Tests for the HTML5 engine of GDevelop",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "karma start --browsers ChromeHeadless --single-run",
    "test:watch": "karma start --browsers ChromeHeadless",
    "test:chromeHeadlessNoSandbox": "karma start --browsers ChromeHeadlessNoSandbox --single-run",
    "test-benchmark": "karma start --browsers ChromeHeadless --single-run --enableBenchmarks",
    "test-benchmark:watch": "karma start --browsers ChromeHeadless --enableBenchmarks",
    "test:firefox": "karma start --browsers Firefox --single-run",
    "test:firefox:watch": "karma start --browsers Firefox",
    "test:chrome": "karma start --browsers Chrome --single-run",
    "test:chrome:watch": "karma start --browsers Chrome",
    "test:edge": "karma start --browsers EdgeHeadless --single-run",
    "test:edge:watch": "karma start --browsers EdgeHeadless",
    "test:chromium": "karma start --browsers ChromiumHeadless --single-run",
    "test:chromium:watch": "karma start --browsers ChromiumHeadless"
  },
  "keywords": [
    "HTML5",
    "games",
    "engine",
    "Game",
    "Develop"
  ],
  "author": "Florian Rival",
  "license": "MIT",
  "dependencies": {
    "expect.js": "^0.3.1",
    "mocha": "^11.8.0"
  },
  "devDependencies": {
    "@chiragrupani/karma-chromium-edge-launcher": "2.1.1",
    "karma": "^1.7.1",
    "karma-chrome-launcher": "^2.2.0",
    "karma-firefox-launcher": "^1.1.0",
    "karma-mocha": "^1.3.0",
    "karma-sinon": "^1.0.5",
    "sinon": "^15.0.1"
  },
  "overrides": {
    "fsevents": "^1.2.11",
    "minimist": "^1.2.8",
    "mixin-deep": "^2.0.1",
    "set-value": "^4.1.0",
    "socket.io-parser": "^4.2.7",
    "xmlhttprequest-ssl": "^4.0.0",
    "growl": "^1.10.5",
    "lodash": "^4.18.1",
    "minimatch": "^5.1.0",
    "brace-expansion": "^2.0.2",
    "tar": "^6.2.1",
    "shelljs": "^0.9.0",
    "js-yaml": "^4.3.1",
    "follow-redirects": "^1.15.0",
    "async": "^3.0.0",
    "axios": "^1.7.0",
    "extract-zip": "^2.0.1",
    "picomatch": "^3.0.1",
    "tmp": "^0.2.7",
    "esbuild": "^0.25.0",
    "form-data": "^4.0.6",
    "qs": "^6.15.3",
    "cookie": "^0.7.0",
    "ws": "^8.18.0",
    "diff": "^5.2.0",
    "debug": "^2.6.9",
    "braces": "^3.0.3",
    "@xmldom/xmldom": "^0.9.0",
    "log4js": "^6.9.1",
    "socket.io": "^4.8.1"
  }
}
